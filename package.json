{
  "name": "book-club-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "extract-i18n": "node scripts/extract-i18n.mjs",
    "extract-i18n:clean": "node scripts/extract-i18n.mjs --clean",
    "lint": "ng lint",
    "build-ctx": "npx repomix --no-files",
    "prepare": "husky || true",
    "mock": "node mock-server/index.js",
    "dev": "concurrently --names \"ng,mock\" -c \"cyan,green\" \"npm start\" \"npm run mock\"",
    "audit:full": "npx playwright test --config=playwright.full-audit.config.ts",
    "audit:full:ui": "npx playwright test --config=playwright.full-audit.config.ts e2e/ui",
    "audit:full:api": "npx playwright test --config=playwright.full-audit.config.ts e2e/api",
    "parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/parity/har-diff.ts",
    "parity:setup-member": "playwright test --config=playwright.parity-setup.config.ts",
    "parity:seo": "playwright test --config=playwright.parity.config.ts e2e/parity/seo.spec.ts",
    "parity:visual": "playwright test --config=playwright.parity.config.ts e2e/parity/visual.spec.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.6",
    "picomatch": "^4.0.4",
    "axios": "^1.20.0",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1",
    "ws": ">=8.20.1",
    "yaml": ">=2.8.3",
    "follow-redirects": ">=1.16.0",
    "esbuild": ">=0.28.1",
    "vite": ">=7.3.5",
    "form-data": ">=4.0.6",
    "piscina": ">=5.3.2",
    "nx": {
      ".": ">=23.2.1",
      "brace-expansion": "^5.0.12"
    },
    "smol-toml": ">=1.9.0",
    "@angular/build": {
      "undici": "^7.28.0"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/google-maps": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@spartan-ng/brain": "1.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@spartan-ng/cli": "^1.5.0",
    "@types/google.maps": "^3.65.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.2"
  }
}
